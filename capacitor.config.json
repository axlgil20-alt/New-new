{
  "appId": "com.aistudio.quetzi.chapin",
  "appName": "Quetzi",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3500,
      "launchAutoHide": true,
      "backgroundColor": "#022C22",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
